# Firebase web app config (Firebase console > Project settings > Your apps).
# These values are public identifiers, not secrets: they ship in the page.
# Access is controlled by firestore.rules. Copy this file to .env.local.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional: reCAPTCHA v3 site key for Firebase App Check (spam protection
# for the booking form).
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Local development against the Firebase emulators (npm run emulators).
# VITE_FIREBASE_EMULATORS=1
